# Copy this to .env. Keep real credentials out of Git.
# FalkorDB Cloud: run python scripts/configure-falkordb.py to set these locally.
# Leave GRAPH_HOST empty for the normal local Docker configuration.
WORKWEAVE_GRAPH_HOST=
WORKWEAVE_GRAPH_PORT=6379
WORKWEAVE_GRAPH_USERNAME=
WORKWEAVE_GRAPH_PASSWORD=
# The setup helper uses a secret file so special password characters stay literal.
WORKWEAVE_GRAPH_PASSWORD_FILE=
WORKWEAVE_GRAPH_PASSWORD_FILE_HOST=
WORKWEAVE_GRAPH_TLS=true
# Enable secure cookies for a public HTTPS deployment. Keep false for local HTTP.
WORKWEAVE_SECURE_COOKIES=false
# For HTTPS hosting, set the exact public hostname here (JSON array).
WORKWEAVE_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
WORKWEAVE_ADMIN_USERNAME=admin
# If blank, read /data/workweave/bootstrap-password.txt after first startup.
WORKWEAVE_ADMIN_PASSWORD=
WORKWEAVE_GROQ_KEY=
WORKWEAVE_GEMINI_KEY=
WORKWEAVE_GROQ_MODEL=openai/gpt-oss-120b
WORKWEAVE_GEMINI_MODEL=gemini-3.5-flash-lite
WORKWEAVE_OLLAMA_MODEL=qwen3:8b
# Optional hosted chat provider, separate from self-hosted Ollama embeddings.
# Configure the key in deployment secrets or the local encrypted vault.
WORKWEAVE_OLLAMA_CLOUD_KEY=
WORKWEAVE_OLLAMA_CLOUD_MODEL=gemma4:31b
# Fixed embedding space. Changing this requires deliberate reindexing.
WORKWEAVE_EMBEDDING_MODEL=embeddinggemma:300m
WORKWEAVE_ALLOW_PRIVATE_DRIVE=false
WORKWEAVE_GOOGLE_CLIENT_ID=
WORKWEAVE_GOOGLE_CLIENT_SECRET=
WORKWEAVE_GOOGLE_PICKER_KEY=
WORKWEAVE_GOOGLE_PROJECT_ID=
WORKWEAVE_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/google/callback
